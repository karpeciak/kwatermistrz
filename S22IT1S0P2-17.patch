+{% extends "baza.html" %}
+{% block tytul %}Przejazd alternatywny – {{ d.id_delegacji }}{% endblock %}
+{% block tresc %}
+<p><a href="/app/wnioski/{{ d.id_delegacji }}">← Wniosek {{ d.id_delegacji }}</a></p>
+
+<div class="naglowek-strony">
+  <h2>Zmiana przejazdu</h2>
+  <span class="status duzy {{ d.status | klasa_statusu }}">{{ d.status }}</span>
+</div>
+
+{% if komunikat %}
+<p class="{{ 'bledy' if blad else 'komunikat' }}" role="{{ 'alert' if blad else 'status' }}">{{ komunikat }}</p>
+{% endif %}
+
+{# S22IT1S0P2-17 (krok 2): informacja o odwołaniu przejazdu przez przewoźnika #}
+{% macro opis_kursu(p) -%}
+  {%- set pol = polaczenia.get(p.id_polaczenia) if p.id_polaczenia else none -%}
+  <strong>{{ p.srodek_transportu }}</strong>
+  {%- if pol %} · {{ pol.przewoznik }}<br><small>{{ pol.skad }} → {{ pol.dokad }}</small>{% endif %}
+{%- endmacro %}
+
+{% for p in odwolane %}
+{% set pol = polaczenia.get(p.id_polaczenia) if p.id_polaczenia else none %}
+<article class="komunikat ostrzezenie" role="status">
+  <p><strong>Przewoźnik odwołał przejazd {{ p.kierunek | lower }}</strong> –
+    {{ p.data_przejazdu.strftime('%d.%m.%Y') }}{% if pol %}, {{ pol.godzina_odjazdu.strftime('%H:%M') }}{% endif %}:
+    {{ opis_kursu(p) }}</p>
+  {% if p.powod_zmiany %}<p><small>{{ p.powod_zmiany.splitlines()[0] }}</small></p>{% endif %}
+</article>
+{% endfor %}
+
+{% if propozycje %}
+<p>Wybierz przejazd zastępczy. Wszystkie propozycje zapewniają przybycie na czas
+  {%- if budzet is not none %} i mieszczą się w dostępnym budżecie jednostki ({{ budzet | kwota }}){% endif %}.
+  Po wyborze system anuluje odwołaną rezerwację, zarezerwuje nowy przejazd i zaktualizuje dokumentację delegacji.</p>
+
+<form method="post" action="/app/wnioski/{{ d.id_delegacji }}/przejazd-alternatywny">
+  <fieldset>
+    <legend><strong>Przejazdy alternatywne</strong></legend>
+    <div class="overflow-auto">
+      <table>
+        <thead>
+          <tr>
+            <th scope="col">Przejazd</th>
+            <th scope="col">Data</th>
+            <th scope="col">Odjazd – przyjazd</th>
+            <th scope="col">Przesiadki</th>
+            <th scope="col">Koszt</th>
+          </tr>
+        </thead>
+        <tbody>
+          {% for p in propozycje %}
+          {% set pol = polaczenia.get(p.id_polaczenia) if p.id_polaczenia else none %}
+          {% set zaznacz = (p.id_przejazdu == zaznaczony) if zaznaczony else p.rekomendowany %}
+          <tr>
+            <td>
+              <label>
+                <input type="radio" name="id_przejazdu" value="{{ p.id_przejazdu }}" required {% if zaznacz %}checked{% endif %}>
+                {{ opis_kursu(p) }}
+              </label>
+              {% if p.rekomendowany %}<mark>rekomendowany</mark>{% endif %}
+              {% if p.uzasadnienie %}<br><small>{{ p.uzasadnienie }}</small>{% endif %}
+            </td>
+            <td class="bez-lamania">{{ p.data_przejazdu.strftime('%d.%m.%Y') }}</td>
+            <td class="bez-lamania">{% if pol %}{{ pol.godzina_odjazdu.strftime('%H:%M') }} – {{ pol.godzina_przyjazdu.strftime('%H:%M') }}{% else %}–{% endif %}</td>
+            <td>{% if pol %}{{ pol.liczba_przesiadek }}{% else %}–{% endif %}</td>
+            <td class="bez-lamania">{% if p.koszt is not none %}{{ p.koszt | kwota }}{% else %}–{% endif %}</td>
+          </tr>
+          {% endfor %}
+        </tbody>
+      </table>
+    </div>
+  </fieldset>
+  <input type="hidden" name="csrf" value="{{ csrf }}">
+  <label for="uzasadnienie">Uwagi do wyboru <small>(opcjonalnie)</small>
+    <textarea id="uzasadnienie" name="uzasadnienie" rows="2" maxlength="500">{{ uzasadnienie or '' }}</textarea>
+  </label>
+  <button type="submit">Wybierz przejazd alternatywny</button>
+</form>
+
+{# Scenariusz 3a–4a: żaden zamiennik nie odpowiada delegowanemu #}
+<details>
+  <summary>Żaden przejazd mi nie odpowiada</summary>
+  <form method="post" action="/app/wnioski/{{ d.id_delegacji }}/przejazd-alternatywny/odrzucenie">
+    <input type="hidden" name="csrf" value="{{ csrf }}">
+    <label for="przyczyna">Przyczyna odrzucenia *
+      <textarea id="przyczyna" name="przyczyna" rows="2" maxlength="500" required></textarea>
+    </label>
+    <button type="submit" class="secondary">Odrzuć i przekaż do organizatora</button>
+  </form>
+</details>
+{% elif odwolane %}
+<p class="komunikat" role="status">Brak przejazdu zastępczego, który zapewnia przybycie na czas w budżecie jednostki,
+  albo propozycje zostały odrzucone. Sprawę przejazdu przejęła osoba odpowiedzialna za organizację delegacji.</p>
+{% elif not komunikat %}
+<p>Żaden przejazd tej delegacji nie został odwołany.</p>
+{% endif %}
+
+<p><a href="/app/wnioski/{{ d.id_delegacji }}/przejazd">Zobacz zarezerwowane przejazdy</a></p>
+{% endblock %}
