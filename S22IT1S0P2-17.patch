+    assert list(statusy.values()).count(StatusRezerwacji.ANULOWANA) == 4  # stara rezerwacja + 3 niewybrane
+    assert delegacja().status == Status.ZORGANIZOWANY  # Koordynator po wyniku transportu
+    with sesja() as s:
